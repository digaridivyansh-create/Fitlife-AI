# Application settings
APP_NAME=FitLife AI Service
APP_ENV=development
HOST=127.0.0.1
PORT=8001

# Must match backend AI_SERVICE_TOKEN
AI_SERVICE_TOKEN=replace-with-the-same-secret-used-by-backend

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-name

# USDA FoodData Central (optional if not using the API)
USDA_FDC_API_KEY=your-usda-api-key
