# PostgreSQL database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=fitlife_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=your-local-database-password

# Authentication: use a randomly generated secret of at least 40 characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-40-characters

# Server
PORT=5000
HOST=127.0.0.1

# Internal Python AI service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=replace-with-the-same-secret-used-by-ai-service
